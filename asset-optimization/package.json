{
  "name": "datocms-plugin-asset-optimization",
  "homepage": "https://github.com/datocms/plugins/tree/master/asset-optimization#readme",
  "version": "0.7.12",
  "author": "DatoCMS <support@datocms.com>",
  "description": "A plugin that allows you to mass apply optimizations to your DatoCMS assets.",
  "keywords": [
    "datocms",
    "datocms-plugin"
  ],
  "type": "module",
  "datoCmsPlugin": {
    "title": "Asset Optimization",
    "coverImage": "docs/cover-1200x800.png",
    "previewImage": "docs/preview.mp4",
    "entryPoint": "dist/index.html",
    "permissions": [
      "currentUserAccessToken"
    ]
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "lint": "biome check src tests package.json tsconfig.test.json",
    "lint:fix": "biome check src tests package.json tsconfig.test.json --write",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@datocms/cma-client-browser": "^6.1.0",
    "datocms-plugin-sdk": "^2.2.2",
    "datocms-react-ui": "^2.2.4",
    "lodash.debounce": "^4.0.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@biomejs/biome": "^2.4.10",
    "tsx": "^4.23.15",
    "@types/node": "^26.6.4"
  },
  "overrides": {
    "datocms-react-ui": {
      "react-intersection-observer": "^9.16.0",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
