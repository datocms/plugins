{
  "name": "datocms-plugin-delete-assets-option",
  "homepage": "https://github.com/datocms/plugins/tree/master/delete-assets-option#readme",
  "version": "4.0.0-next.0",
  "author": "DatoCMS <support@datocms.com>",
  "description": "Prompts the users to delete assets only referenced in the records they are deleting",
  "keywords": [
    "datocms",
    "datocms-plugin",
    "assets",
    "asset",
    "media",
    "delete"
  ],
  "datoCmsPlugin": {
    "title": "Delete Assets Option",
    "previewImage": "docs/preview.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html",
    "permissions": [
      "currentUserAccessToken"
    ]
  },
  "dependencies": {
    "@datocms/cma-client-browser": "^6.1.0",
    "datocms-plugin-sdk": "^3.0.0-next.3"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run --passWithNoTests --maxWorkers=2",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "biome check src",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^25.5.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
