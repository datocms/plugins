{
  "name": "datocms-plugin-delete-unused-assets",
  "homepage": "https://github.com/datocms/plugins/tree/master/delete-unused-assets#readme",
  "version": "0.4.1",
  "author": "DatoCMS <support@datocms.com>",
  "description": "Find the assets no record uses, review them, and delete the ones you don't need.",
  "keywords": [
    "datocms",
    "datocms-plugin",
    "assets",
    "asset",
    "delete"
  ],
  "datoCmsPlugin": {
    "title": "Delete Unused Assets",
    "coverImage": "docs/cover-1200x800.png",
    "previewImage": "docs/preview.mp4",
    "entryPoint": "dist/index.html",
    "permissions": [
      "currentUserAccessToken"
    ]
  },
  "dependencies": {
    "@datocms/cma-client-browser": "^6.1.0",
    "datocms-plugin-sdk": "^2.3.0",
    "datocms-react-ui": "^2.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "biome check src",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2",
    "@biomejs/biome": "2.4.10",
    "@testing-library/react": "16.3.2",
    "jsdom": "28.1.0"
  },
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "overrides": {
    "datocms-react-ui": {
      "react-intersection-observer": "^9.16.0",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
