{
  "name": "datocms-plugin-seo-readability-analysis",
  "homepage": "https://github.com/datocms/plugins/tree/master/seo-readability-analysis#readme",
  "version": "2.2.5",
  "description": "Run SEO/Readability analysis using YoastSEO.js on your frontend everytime you make a change to the content of a record",
  "author": "DatoCMS <support@datocms.com>",
  "license": "GPLv3",
  "files": [
    "docs",
    "dist"
  ],
  "keywords": [
    "datocms",
    "datocms-plugin",
    "field-editor",
    "json-field",
    "seo",
    "analysis",
    "keywords",
    "readability"
  ],
  "private": false,
  "datoCmsPlugin": {
    "title": "SEO/Readability Analysis",
    "previewImage": "docs/preview.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "datocms-plugin-sdk": "^3.0.0-next.3",
    "datocms-react-ui": "^3.1.0-next.6",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yoastseo": "^3.6.0"
  },
  "scripts": {
    "build": "npm run build-worker && tsc -b && vite build",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "build-worker": "esbuild workerSrc/index.js --bundle --format=iife --outfile=public/main.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "events": "^3.3.0",
    "globals": "^17.4.0",
    "tokenizer2": "file:vendor/tokenizer2",
    "typescript": "^5.9.3",
    "url": "^0.11.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@babel/runtime": "^7.28.6",
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    },
    "yoastseo": {
      "@wordpress/i18n": "^6.0.0"
    }
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
