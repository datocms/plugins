{
  "name": "datocms-plugin-star-rating-editor",
  "version": "0.2.7",
  "homepage": "https://github.com/datocms/plugins/tree/master/star-rating-editor#readme",
  "description": "A plugin that presents integer fields as star rating widgets",
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "datocms-plugin-sdk": "^3.0.0-next.3",
    "datocms-react-ui": "^3.1.0-next.6",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "keywords": [
    "datocms",
    "datocms-plugin",
    "field-editor",
    "integer-field",
    "rating"
  ],
  "datoCmsPlugin": {
    "title": "Star rating editor",
    "previewImage": "docs/preview.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html",
    "permissions": []
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "overrides": {
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
