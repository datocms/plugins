{
  "name": "datocms-plugin-table-editor",
  "description": "A table editor that outputs JSON objects",
  "homepage": "https://github.com/datocms/plugins/tree/master/table-editor#readme",
  "version": "4.0.0-next.0",
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "datocms-plugin-sdk": "^3.0.0-next.3",
    "datocms-react-ui": "^3.1.0-next.6",
    "dequal": "^2.0.2",
    "fast-deep-equal": "^3.1.3",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-table": "7.7.0",
    "react-textarea-autosize": "^8.5.9",
    "use-deep-compare": "^1.3.0"
  },
  "keywords": [
    "datocms",
    "datocms-plugin"
  ],
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react-table": "7.7.9",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    },
    "react-table": {
      "react": "$react"
    }
  },
  "datoCmsPlugin": {
    "title": "Table Editor",
    "previewImage": "docs/demo.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html"
  },
  "type": "module",
  "allowScripts": {
    "@fortawesome/fontawesome-common-types": false,
    "@fortawesome/fontawesome-svg-core": false,
    "@fortawesome/free-solid-svg-icons": false,
    "esbuild": true,
    "fsevents": true
  }
}
