{
  "name": "datocms-plugin-tree-like-slugs",
  "homepage": "https://github.com/datocms/plugins/tree/master/tree-like-slugs#readme",
  "version": "4.0.0-next.0",
  "author": "DatoCMS <support@datocms.com>",
  "description": "A plugin that makes it so the slugs in models with Hierarchical Sorting (tree-like models) are passed down to child records",
  "keywords": [
    "datocms",
    "datocms-plugin",
    "slug",
    "tree"
  ],
  "type": "module",
  "datoCmsPlugin": {
    "title": "Tree-like slugs (for models with Hierarchical Sorting)",
    "coverImage": "docs/cover.png",
    "previewImage": "docs/preview.mp4",
    "entryPoint": "dist/index.html",
    "permissions": [
      "currentUserAccessToken"
    ]
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc -b",
    "lint": "biome check src vite.config.ts",
    "lint:fix": "biome check --write src vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@datocms/cma-client-browser": "^6.1.0",
    "datocms-plugin-sdk": "^3.0.0-next.3",
    "datocms-react-ui": "^3.1.0-next.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
