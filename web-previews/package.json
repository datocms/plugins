{
  "name": "datocms-plugin-web-previews",
  "homepage": "https://github.com/datocms/plugins/tree/master/web-previews#readme",
  "description": "Add a Visual tab for full-screen side-by-side editing with click-to-edit overlays, preview links in the record sidebar, and inline iframe previews with viewport presets",
  "version": "1.1.6",
  "author": "DatoCMS <support@datocms.com>",
  "license": "GPLv3",
  "files": [
    "docs",
    "dist"
  ],
  "keywords": [
    "datocms",
    "datocms-plugin",
    "sidebar",
    "preview",
    "links"
  ],
  "private": false,
  "datoCmsPlugin": {
    "title": "Web Previews",
    "previewImage": "docs/preview.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@paralleldrive/cuid2": "^2.3.1",
    "@types/lodash-es": "^4.17.12",
    "datocms-plugin-sdk": "^3.0.0-next.3",
    "datocms-react-ui": "^3.1.0-next.6",
    "lodash-es": "^4.17.23",
    "penpal": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-merge-refs": "^3.0.2",
    "use-deep-compare": "1.1.0",
    "usehooks-ts": "^3.1.1"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "dev": "vite --port 3000",
    "preview": "vite preview",
    "format": "biome check --write --unsafe ./src",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "type": "module",
  "overrides": {
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
