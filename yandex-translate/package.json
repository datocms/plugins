{
  "name": "datocms-plugin-yandex-translate",
  "version": "0.1.11",
  "author": "DatoCMS <support@datocms.com>",
  "homepage": "https://github.com/datocms/plugins/tree/master/yandex-translate#readme",
  "description": "Makes it easier to automatically translate your content into secondary languages",
  "license": "ISC",
  "scripts": {
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "files": [
    "docs",
    "dist"
  ],
  "datoCmsPlugin": {
    "title": "Yandex Translate",
    "previewImage": "docs/demo.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html"
  },
  "keywords": [
    "datocms",
    "datocms-plugin",
    "field-addon",
    "translate"
  ],
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "datocms-plugin-sdk": "^2.6.0-next.1",
    "datocms-react-ui": "^3.1.0-next.5",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "type": "module",
  "overrides": {
    "datocms-react-ui": {
      "datocms-plugin-sdk": "$datocms-plugin-sdk"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
